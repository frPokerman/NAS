        <div class="horizontal-flex width-p20 hidden left-panel align-center no-shrink">
            <!-- icon -->
            <span id="search_result_category" class="legend compact no-wrap">Category</span>
        </div>
        <div class="horizontal-flex fit-flex between hidden">
            <span id="search_result_title" class="no-wrap hidden">Title</span>
            <div id="search_result_quickview" class="horizontal-flex-4 align-center"></div>
        </div>
    </div>
</template>

<template id="search_quickview_label_template">
    <span class="label contrast">Info</span>
</template>