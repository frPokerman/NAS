{% extends "generic/base.html.twig" %}

{% block page_content %}
<div class="horizontal-flex widget window fit-flex">
    <div class="vertical-flex left-panel between width-240 top-padding-24">
        {% block left_panel %}{% endblock %}
    </div>
    <div class="fill-width block-padding-24 vertical-flex align-center gap-16">
        <div class="compact">
            {% embed "search/bar.html.twig" %}{% endembed %}
        </div>
        <div class="fill auto-scroll center">
            {% block window_content %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}